---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  schemas?: Record<string, any>[];
}

const {
  title = 'Piscine : calcul des doses et diagnostic de l’eau | EauTopie',
  description = 'EauTopie t’aide à entretenir ta piscine : doses en grammes selon ton volume, diagnostic des problèmes d’eau et suivi de tes mesures. Gratuit, sans inscription.',
  image = '/og-image.png',
  noindex = false,
  schemas = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#0EA5E9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="EauTopie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Données structurées (JSON-LD) */}
    {schemas.length > 0 && <StructuredData schema={schemas} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieConsent />

    <script>
      // Si l'utilisateur est déjà sur la liste d'attente Premium, on transforme tous
      // les boutons « Premium : liste d’attente » en état « inscrit » (désactivé, visuel).
      const PREMIUM_KEY = 'eautopie_premium_signup';

      function majBoutonsPremium() {
        let inscrit = false;
        try {
          inscrit = !!window.localStorage.getItem(PREMIUM_KEY);
        } catch {
          inscrit = false;
        }
        if (!inscrit) return;

        document
          .querySelectorAll<HTMLAnchorElement>('[data-premium-btn]')
          .forEach((el) => {
            const label =
              el.querySelector<HTMLElement>('[data-premium-label]') ?? el;
            label.textContent = 'Tu es sur la liste d’attente ✓';
            el.removeAttribute('href');
            el.setAttribute('aria-disabled', 'true');
            el.classList.add(
              'cursor-default',
              'opacity-70',
              'pointer-events-none'
            );
          });
      }

      majBoutonsPremium();
      document.addEventListener('astro:page-load', majBoutonsPremium);
    </script>
  </body>
</html>
